#!/bin/bash
# =============================================================================
# PRE-COMMIT HOOK - Blocks bad commits
# =============================================================================

echo "🔍 Running pre-commit validation..."

# Step 1: Syntax validation
cd agent-runner || exit 1
npm run validate-syntax 2>&1 | tee /tmp/pre-commit-syntax.log

if [ ${PIPESTATUS[0]} -ne 0 ]; then
  echo ""
  echo "❌ COMMIT BLOCKED: Syntax errors detected"
  echo "Run 'npm run diagnose-syntax' to see errors"
  echo ""
  echo "Last 20 lines of output:"
  tail -20 /tmp/pre-commit-syntax.log
  exit 1
fi

# Step 2: TypeScript check (allow warnings, block errors)
echo ""
echo "🔍 Running TypeScript check..."
npm run build 2>&1 | tee /tmp/pre-commit-tsc.log

# Count TypeScript errors (lines containing "error TS")
ERROR_COUNT=$(grep -E "error TS[0-9]+" /tmp/pre-commit-tsc.log | wc -l | tr -d ' ')

if [ "$ERROR_COUNT" -gt 10 ]; then
  echo ""
  echo "❌ COMMIT BLOCKED: $ERROR_COUNT TypeScript errors detected"
  echo ""
  echo "First 10 errors:"
  grep -E "error TS[0-9]+" /tmp/pre-commit-tsc.log | head -10
  exit 1
fi

# Step 3: File size check (detect accidental bloat)
echo ""
echo "🔍 Checking file sizes..."
LARGE_FILES=$(find . -name "*.ts" -o -name "*.tsx" | xargs ls -lh 2>/dev/null | awk '$5 > 1048576 {print $9, $5}' | head -5)

if [ -n "$LARGE_FILES" ]; then
  echo "⚠️  WARNING: Large files detected:"
  echo "$LARGE_FILES"
  echo ""
  echo "Consider splitting large files for better maintainability"
fi

# Step 4: Check for common bad patterns
echo ""
echo "🔍 Checking for bad patterns..."
BAD_PATTERNS=0

# Check for console.log in production code (allow in scripts)
if grep -r "console\.log" --include="*.ts" --include="*.tsx" --exclude-dir=scripts --exclude-dir=test . | grep -v "//.*console.log" | head -5 | grep -q .; then
  echo "⚠️  WARNING: console.log found in production code"
  BAD_PATTERNS=$((BAD_PATTERNS + 1))
fi

# Check for TODO/FIXME without ticket numbers
if grep -r "TODO\|FIXME" --include="*.ts" --include="*.tsx" --exclude-dir=scripts . | grep -v "#[0-9]" | head -5 | grep -q .; then
  echo "⚠️  WARNING: TODO/FIXME without ticket numbers found"
  BAD_PATTERNS=$((BAD_PATTERNS + 1))
fi

if [ "$BAD_PATTERNS" -gt 0 ]; then
  echo ""
  echo "⚠️  Warnings found but not blocking commit"
fi

# Step 5: AI Code Review (optional, requires ANTHROPIC_API_KEY)
if [ -n "$ANTHROPIC_API_KEY" ]; then
  echo ""
  echo "🤖 Running AI code review..."
  cd ..
  tsx scripts/ai-code-review.ts --pre-commit
  
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ COMMIT BLOCKED: AI review detected issues"
    exit 1
  fi
else
  echo ""
  echo "⚠️  AI review skipped (ANTHROPIC_API_KEY not set)"
fi

echo ""
echo "✅ Pre-commit checks passed"
exit 0

