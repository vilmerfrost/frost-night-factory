{
  "extends": "./tsconfig.core.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "./*.ts",
    "./scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "workspace",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
