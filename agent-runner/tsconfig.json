{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["esnext", "dom"],
    "typeRoots": ["../node_modules/@types", "./node_modules/@types"]
  },
  "include": ["**/*.ts", "../lib/**/*.ts", "types.d.ts"],
  "exclude": [
    "node_modules",
    "workspace/sandbox"
  ]
}